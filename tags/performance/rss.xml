&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;Largest paint, page with maths and code&lt;/td&gt;
&lt;td style=&quot;text-align: right&quot;&gt;3.75 s&lt;/td&gt;
&lt;td style=&quot;text-align: right&quot;&gt;1.65 s&lt;/td&gt;
&lt;td&gt;2.3 times faster&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td&gt;First paint, page with maths and code&lt;/td&gt;
&lt;td style=&quot;text-align: right&quot;&gt;2.78 s&lt;/td&gt;
&lt;td style=&quot;text-align: right&quot;&gt;1.13 s&lt;/td&gt;
