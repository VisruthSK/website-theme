&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td&gt;Files&lt;/td&gt;
&lt;td style=&quot;text-align: right&quot;&gt;72&lt;/td&gt;
&lt;td style=&quot;text-align: right&quot;&gt;90 (203 with search)&lt;/td&gt;
&lt;/tr&gt;
