&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td&gt;HTML&lt;/td&gt;
&lt;td style=&quot;text-align: right&quot;&gt;130.0 kB&lt;/td&gt;
