doi:10.1002/spe.4380111102&lt;span class=&quot;external-link-icon-wrap&quot;&gt;⁠&lt;/span&gt;&lt;/a&gt;   &lt;/li&gt; &lt;/ol&gt; &lt;/section&gt;</content:encoded><category>code</category><category>features</category></item></channel></rss>