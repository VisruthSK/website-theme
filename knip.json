{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "example*/astro.config.ts",
    "example*/src/content.config.ts",
    "src/pages/**/*.{astro,ts}",
    "src/scripts/*.js",
    "scripts/*.mjs",
    "tests/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,js,astro}",
    "config/**/*.ts",
    "scripts/*.mjs",
    "tests/**/*.ts",
    "example*/*.ts",
    "example*/src/**/*.ts",
    "upstream/src/**/*.{ts,astro}"
  ],
  "ignore": ["upstream/**"],
  "ignoreUnresolved": ["^@/generated/"],
  "paths": { "@/*": ["src/*", "upstream/src/*"] }
}
