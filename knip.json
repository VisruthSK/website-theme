{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "examples/*/astro.config.ts",
    "examples/*/src/content.config.ts",
    "src/pages/**/*.{astro,ts}",
    "src/scripts/*.js",
    "scripts/*.mjs",
    "tests/**/*.ts"
  ],
  "project": [
    "src/**/*.{ts,js,astro}",
    "config/**/*.ts",
    "scripts/*.mjs",
    "tests/**/*.ts",
    "examples/*/*.ts",
    "examples/*/src/**/*.ts",
    "astro-erudite/src/**/*.{ts,astro}"
  ],
  "ignore": ["astro-erudite/**"],
  "ignoreUnresolved": ["^@/generated/"],
  "paths": { "@/*": ["src/*", "astro-erudite/src/*"] }
}
