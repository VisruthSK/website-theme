{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "site": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "href": {
          "type": "string",
          "format": "uri"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "locale": {
          "default": "en-US",
          "type": "string",
          "minLength": 1
        },
        "dir": {
          "default": "ltr",
          "type": "string",
          "enum": [
            "ltr",
            "rtl"
          ]
        },
        "postsPerPage": {
          "default": 10,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "featuredPostCount": {
          "default": 3,
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "featured": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "footer": {
          "type": "string"
        },
        "themeColor": {
          "type": "object",
          "properties": {
            "light": {
              "type": "string",
              "minLength": 1
            },
            "dark": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "light",
            "dark"
          ],
          "additionalProperties": false
        },
        "manifest": {
          "type": "object",
          "properties": {
            "background": {
              "type": "string",
              "minLength": 1
            },
            "theme": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "background",
            "theme"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "title",
        "description",
        "href",
        "author",
        "themeColor",
        "manifest"
      ],
      "additionalProperties": false
    },
    "text": {
      "default": {
        "recentDescription": "Every post in reverse chronological order.",
        "searchPlaceholder": "Search"
      },
      "type": "object",
      "properties": {
        "recentDescription": {
          "default": "Every post in reverse chronological order.",
          "type": "string",
          "minLength": 1
        },
        "searchPlaceholder": {
          "default": "Search",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "collection": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "required": [
          "slug",
          "label",
          "collection"
        ],
        "additionalProperties": false
      }
    },
    "navigation": {
      "type": "array",
      "items": {
