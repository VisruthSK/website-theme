{
  "compilerOptions": {
    "target": "ES2025",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2025", "DOM", "DOM.Iterable"],
    "types": ["node", "astro/client"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "paths": { "@/*": ["./src/*", "./astro-erudite/src/*"] }
  },
  "include": ["tests/**/*.ts", "src/virtual.d.ts"]
}
