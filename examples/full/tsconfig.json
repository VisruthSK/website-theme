{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*", "../../src/*", "../../astro-erudite/src/*"]
    }
  },
  "include": [
    ".astro/types.d.ts",
    "**/*",
    "../../src/**/*",
    "../../config/**/*",
    "../../tests/**/*",
    "../../playwright.config.ts"
  ],
  "exclude": ["dist", "public/pagefind", "src/generated"]
}
