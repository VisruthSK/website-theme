{
  "$schema": "../../config/theme.schema.json",
  "site": {
    "title": "Example Site",
    "description": "Public domain stories, and an LLM written benchmark",
    "href": "https://visruthsk.github.io/website-theme/",
    "author": "Example Author",
    "featured": ["everything", "measuring-the-theme"]
  },
  "sections": [
    {
      "slug": "essays",
      "label": "Essays",
      "collection": "essays"
    },
    {
      "slug": "notes",
      "label": "Notes",
      "collection": "notes"
    }
  ],
  "navigation": [
    {
      "section": "essays"
    },
    {
      "section": "notes"
    },
    {
      "href": "/reading",
      "label": "Reading"
    },
    {
      "href": "/tags",
      "label": "Tags"
    },
    {
      "href": "/about",
      "label": "About"
    },
    {
      "href": "https://example.org/",
      "label": "Elsewhere"
    },
    {
      "href": "/search",
      "label": "Search"
    }
  ],
  "footer": {
    "text": "Story text from Project Gutenberg, in the public domain.",
    "links": [
      {
        "href": "/rss.xml",
        "label": "RSS",
        "icon": "rss"
      },
      {
        "href": "https://github.com/example",
        "label": "GitHub",
        "icon": "github"
      },
      {
        "href": "mailto:author@example.com",
        "label": "Email",
        "icon": "mail"
      }
    ]
  },
  "fonts": {
    "body": {
      "family": "IBM Plex Sans",
      "smallCaps": false,
      "faces": [
        {
          "file": "plex-sans-400-normal.woff2"
        },
        {
          "file": "plex-sans-400-italic.woff2",
          "style": "italic"
        },
        {
          "file": "plex-sans-600-normal.woff2",
          "weight": 600
        }
      ]
    },
    "heading": {
      "family": "IBM Plex Sans",
      "faces": [
        {
          "file": "plex-sans-600-normal.woff2",
          "weight": 600
        }
      ]
    },
    "mono": {
      "family": "IBM Plex Mono",
      "faces": [
        {
          "file": "plex-mono-400-normal.woff2"
        }
      ]
    },
    "dropCap": {
      "family": "IBM Plex Sans",
      "file": "plex-sans-600-normal.woff2",
      "size": "6.1rem",
      "tolerance": 1,
      "weight": 600
    }
  }
}
