{
  "$schema": "../../config/theme.schema.json",
  "site": {
    "title": "Field Journal",
    "description": "Public domain stories in a quiet setting",
    "href": "https://journal.example.net/",
    "author": "Sample Writer",
    "locale": "en-GB",
    "postsPerPage": 5
  },
  "sections": [
    {
      "slug": "journal",
      "label": "Journal",
      "collection": "entries"
    }
  ],
  "navigation": [
    {
      "section": "journal"
    },
    {
      "href": "/tags",
      "label": "Tags"
    },
    {
      "href": "/recent",
      "label": "Recent"
    }
  ],
  "pages": {
    "recent": {
      "description": "Every journal entry, newest first."
    },
    "search": {
      "placeholder": "Search the journal"
    }
  },
  "brand": {
    "palette": {
      "paper": "#f4f6ef",
      "night": "#121610",
      "moss": "oklch(0.22 0.03 150)",
      "lichen": "oklch(0.93 0.012 120)",
      "fern": "oklch(0.42 0.1 150)",
      "fern-light": "oklch(0.78 0.11 145)",
      "sage": "oklch(0.92 0.02 130)",
      "sage-dark": "oklch(0.26 0.02 140)",
      "bark": "oklch(0.45 0.03 150)",
      "bark-light": "oklch(0.76 0.02 130)",
      "clay": "oklch(0.5 0.16 30)",
      "clay-light": "oklch(0.72 0.14 30)",
      "straw": "oklch(0.56 0.11 85)",
      "straw-light": "oklch(0.8 0.11 90)",
      "pine": "oklch(0.45 0.12 150)",
      "pine-light": "oklch(0.75 0.12 145)"
    },
    "background": {
      "light": "paper",
      "dark": "night"
    },
    "foreground": {
      "light": "moss",
      "dark": "lichen"
    },
    "primary": {
      "light": "fern",
      "dark": "fern-light"
    },
    "secondary": {
      "light": "bark",
      "dark": "bark-light"
    },
    "tertiary": {
      "light": "sage",
      "dark": "sage-dark"
    },
    "warning": {
      "light": "straw",
      "dark": "straw-light"
    },
    "danger": {
      "light": "clay",
      "dark": "clay-light"
    }
  },
  "colors": {
    "border": {
      "light": "oklch(0.8 0.025 130)",
      "dark": "oklch(0.42 0.025 140)"
    },
    "ring": {
      "light": "pine",
      "dark": "pine-light"
    },
    "surface-hover": {
      "light": "oklch(0.945 0.015 125)",
      "dark": "oklch(0.22 0.015 140)"
    },
    "highlight": {
      "light": "oklch(0.88 0.08 95)",
      "dark": "oklch(0.36 0.06 95)"
    },
    "flourish": {
      "light": "fern",
      "dark": "fern-light"
    }
  },
  "fonts": {
    "body": {
      "family": "Atkinson Hyperlegible",
      "fallback": ["ui-sans-serif", "system-ui", "sans-serif"],
      "faces": [
        {
          "file": "atkinson-hyperlegible-400-normal.woff2"
        },
        {
          "file": "atkinson-hyperlegible-400-italic.woff2",
          "style": "italic"
        },
        {
          "file": "atkinson-hyperlegible-700-normal.woff2",
          "weight": 700
        }
      ]
    },
    "heading": {
      "family": "Literata",
      "fallback": ["ui-serif", "Georgia", "serif"],
      "faces": [
        {
          "file": "literata-700-normal.woff2",
          "weight": 700
        }
      ]
    }
  },
  "prose": {
    "fontSize": "1.0625rem",
    "lineHeight": "1.7rem",
    "indent": "1.5em"
  },
  "features": {
    "typeset": true,
    "citations": false,
    "marginNotes": false,
    "math": false,
    "callouts": false,
    "dropCap": false,
    "search": false,
    "externalLinkIcons": false
  }
}
