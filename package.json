{
  "name": "website-theme",
  "description": "An Astro 7 theme for long-form writing, built on astro-erudite.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev --root examples/full",
    "build": "node scripts/build.mjs examples/full examples/minimal",
    "check": "astro check --root examples/full && astro check --root examples/minimal",
    "test": "playwright test",
    "format": "prettier --check .",
    "knip": "knip",
    "schema": "node scripts/schema.mjs",
    "flatten": "node scripts/flatten.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "@expressive-code/plugin-collapsible-sections": "^0.44.3",
    "@expressive-code/plugin-line-numbers": "^0.44.3",
    "@kitlangton/justice": "^0.4.0",
    "@playform/compress": "0.2.5",
    "@web-alchemy/fonttools": "^1.4.0",
    "astro": "^7.4.1",
    "entities": "^8.1.0",
    "esbuild": "0.28.2",
    "github-slugger": "^2.0.0",
    "harfbuzzjs": "^1.6.3",
    "hast-util-from-html": "^2.0.3",
    "hast-util-select": "^6.0.4",
    "hast-util-to-html": "^9.0.5",
    "hastscript": "^9.0.1",
    "mdast-util-to-hast": "^13.2.1",
    "pagefind": "^1.5.2",
    "satteri": "^0.10.5",
    "satteri-expressive-code": "^0.1.24",
    "satteri-validate-links": "^0.3.0",
    "temml": "^0.14.0",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "knip": "^6.42.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
}
