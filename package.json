{
  "name": "website-theme",
  "description": "An Astro 7 theme for long-form writing, built on astro-erudite.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev --root examples/full",
    "build": "node scripts/build.mjs examples/full examples/minimal",
    "check": "astro check --root examples/full && astro check --root examples/minimal",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "test": "playwright test",
    "format": "prettier --check . && node tools/format-astro.mjs",
    "format:write": "prettier --write . && node tools/format-astro.mjs --write",
    "knip": "knip",
    "schema": "node scripts/schema.mjs",
    "schema:check": "node scripts/schema.mjs && git diff --exit-code -- config/theme.schema.json",
    "flatten": "node scripts/flatten.mjs",
    "test:standard": "node --test tests/unit/standard-site.test.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "@expressive-code/plugin-collapsible-sections": "^0.44.4",
    "@expressive-code/plugin-line-numbers": "^0.44.4",
    "@kitlangton/justice": "^0.4.0",
    "@playform/compress": "0.2.5",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@web-alchemy/fonttools": "^1.4.0",
    "astro": "^7.4.13",
    "entities": "^9.0.0",
    "esbuild": "0.28.2",
    "fast-xml-parser": "5.12.1",
    "fast-xml-validator": "^1.4.4",
    "github-slugger": "^2.0.0",
    "harfbuzzjs": "^1.6.3",
    "hast-util-from-html": "^2.1.0",
    "hast-util-select": "^6.0.5",
    "hast-util-to-html": "^9.0.7",
    "hast-util-to-text": "4.0.5",
    "hastscript": "^9.0.3",
    "mdast-util-to-hast": "^13.2.2",
    "pagefind": "^1.6.0",
    "satteri": "^0.11.6",
    "satteri-expressive-code": "^0.1.31",
    "satteri-validate-links": "^0.3.0",
    "temml": "^0.14.0",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "knip": "^6.47.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": false
  }
}
