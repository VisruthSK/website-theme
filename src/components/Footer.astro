---
import SocialIcons from "@/components/SocialIcons.astro"
import { FOOTER, SITE } from "@/consts"
---

<footer>
  <div class="row">
    {FOOTER.text && <p><em>{FOOTER.text}</em></p>}
    <SocialIcons links={FOOTER.links} />
  </div>
  {SITE.monogram && <span class="monogram" aria-hidden="true">{SITE.monogram}</span>}
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2xs);
    margin-block: var(--space-xs) var(--page-offset-bottom);
  }

  .row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);
    inline-size: 100%;

    @media (width >= 40rem) {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 0;
    }
  }

  p {
    margin: 0;
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  .monogram {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-accent, var(--font-serif));
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    line-height: 1;
    color: var(--flourish);
    user-select: none;
  }
</style>
