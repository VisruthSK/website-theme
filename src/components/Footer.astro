---
import SocialIcons from "@/components/SocialIcons.astro"
import { FOOTER, SITE } from "@/consts"
---

<footer>
  <div class="row">
    {FOOTER.text && <p><em>{FOOTER.text}</em></p>}
    {SITE.monogram && <span class="monogram" aria-hidden="true">{SITE.monogram}</span>}
    <SocialIcons links={FOOTER.links} />
  </div>
</footer>

<style>
  footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-block: var(--space-xs) var(--page-offset-bottom);
  }

  .row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-xs);

    @media (width >= 40rem) {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 0;
      inline-size: 100%;
    }
  }

  p {
    margin: 0;
    justify-self: start;
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  .monogram {
    display: inline-flex;
    align-items: center;
    justify-self: center;
    font-family: var(--font-accent, var(--font-serif));
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    line-height: 1;
    color: var(--flourish);
    user-select: none;
  }

  .row :global(ul) {
    justify-self: end;
  }
</style>
