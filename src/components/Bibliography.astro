---
import Link from "@/components/Link.astro"
import { PATHS, PROSE } from "@/consts"
import {
  formatAuthors,
  readBibliography,
  sortEntriesByAuthorYear,
} from "@/lib/bibliography"

interface Props {
  citedKeys: string[]
}

const { citedKeys } = Astro.props
const style = PROSE.citations.style
const authorYear = style === "author-year"
const name = PATHS.bibliography.split(/[\\/]/).at(-1) ?? PATHS.bibliography
const bibliography = readBibliography(PATHS.bibliography)
const entries = citedKeys.flatMap((key) => bibliography?.[key] ?? [])
const sorted = authorYear ? sortEntriesByAuthorYear(entries) : entries

const warning = !bibliography
  ? `Bibliography file not found: ${name}`
  : entries.length === 0
    ? `None of the cited keys were found in ${name}`
    : null
---

{warning ? (
  <div class="bibliography-warning">
    <p>
      <strong>Warning:</strong> {warning}
    </p>
  </div>
) : (
  <section
    class:list={["bibliography", { "bibliography--author-year": authorYear }]}
    aria-label="References"
  >
    <h2 id="references">References</h2>
    <ol class="bibliography-list">
      {sorted.map((entry) => (
        <li id={`ref-${entry.key}`} class="bibliography-entry">
          <span class="bibliography-authors">
            {formatAuthors(entry.author, 100)}
          </span>{" "}
          <span class="bibliography-year">({entry.year ?? "n.d."}).</span>{" "}
          <span class="bibliography-title">{entry.title}.</span>
          {entry.journal && (
            <>
              {" "}
              <em class="bibliography-journal">{entry.journal}</em>
              {entry.volume && (
                <span class="bibliography-volume">, {entry.volume}</span>
              )}
              {entry.issue && (
                <span class="bibliography-issue">({entry.issue})</span>
              )}
              {entry.pages && (
                <span class="bibliography-pages">, {entry.pages}</span>
              )}
              .
            </>
          )}
          {entry.publisher && !entry.journal && (
            <>
              {" "}
              <span class="bibliography-publisher">{entry.publisher}.</span>
            </>
          )}
          {entry.doi && (
            <>
              {" "}
              <Link
                href={`https://doi.org/${entry.doi}`}
                class="bibliography-doi"
              >
                doi:{entry.doi}
              </Link>
            </>
          )}
          {entry.url && !entry.doi && (
            <>
              {" "}
              <Link href={entry.url} class="bibliography-url">
                {entry.url}
              </Link>
            </>
          )}
        </li>
      ))}
    </ol>
  </section>
)}

<style>
  .bibliography {
    margin: 2rem 0;
  }

  .bibliography h2 {
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  .bibliography-list {
    list-style-type: none;
    counter-reset: bibliography-counter;
    padding-left: 0;
  }

  .bibliography-entry {
    counter-increment: bibliography-counter;
    margin-bottom: 1rem;
    padding-left: 2rem;
    position: relative;
    line-height: 1.6;
  }

  .bibliography-entry::before {
    content: "[" counter(bibliography-counter) "]";
    position: absolute;
    left: 0;
    font-weight: 500;
  }

  .bibliography--author-year .bibliography-list {
    counter-reset: none;
  }

  .bibliography--author-year .bibliography-entry {
    counter-increment: none;
    padding-left: 2rem;
    text-indent: -2rem;
  }

  .bibliography--author-year .bibliography-entry::before {
    content: none;
  }

  .bibliography-authors {
    font-weight: 500;
  }

  .bibliography-warning {
    margin: 1rem 0;
    border-left: 4px solid var(--warning);
    border-radius: var(--radius-md);
    padding: 1rem;
    background: var(--surface-warning);
  }

  .bibliography-warning p {
    margin: 0;
    color: var(--ink-strong);
  }
</style>
