---
import ArrowLeft from '@/icons/chevron-left.svg'
import ArrowRight from '@/icons/chevron-right.svg'

interface Props {
  current: number
  last: number
  href: (page: number) => string
}

const { current, last, href } = Astro.props
const pages = Array.from({ length: last }, (_, index) => index + 1)
---

{
  last > 1 && (
    <nav aria-label="Pagination" class="pagination-nav">
      <ul class="pagination-list">
        <li>
          <a
            class:list={['pagination-link', current === 1 && 'is-disabled']}
            aria-disabled={current === 1}
            href={current === 1 ? undefined : href(current - 1)}
          >
            <ArrowLeft aria-hidden="true" />
            <span class="sr-only">Previous page</span>
          </a>
        </li>
        {pages.map((page) => (
          <li>
            <a
              href={href(page)}
              aria-current={page === current ? 'page' : undefined}
              class:list={['pagination-link', page === current && 'is-active']}
            >
              {page}
            </a>
          </li>
        ))}
        <li>
          <a
            class:list={['pagination-link', current === last && 'is-disabled']}
            aria-disabled={current === last}
            href={current === last ? undefined : href(current + 1)}
          >
            <ArrowRight aria-hidden="true" />
            <span class="sr-only">Next page</span>
          </a>
        </li>
      </ul>
    </nav>
  )
}
