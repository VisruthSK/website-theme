---
import SeoMeta from "@/components/SeoMeta.astro"
import { SITE } from "@/consts"
import type { PostEntry } from "@/lib/data-utils"
import { pageTitle, plainTitle, siteOrigin } from "@/lib/site-utils"

type Props = {
  post: PostEntry
  canonical?: string
}

const { post, canonical: canonicalPath } = Astro.props
const { description = SITE.description, date, image, tags } = post.data
const title = plainTitle(post.data.title)

const base = siteOrigin(Astro)
const url = new URL(Astro.url.pathname, base)
const canonical = new URL(canonicalPath ?? Astro.url.pathname, base)
const ogImage = image ? new URL(image.src, base) : undefined

const isoDate = date.toISOString()
const highwireDate = isoDate.slice(0, 10).replaceAll("-", "/")
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  headline: title,
  description,
  url: canonical.href,
  mainEntityOfPage: canonical.href,
  inLanguage: SITE.locale,
  isAccessibleForFree: true,
  datePublished: isoDate,
  dateModified: isoDate,
  author: { "@type": "Person", name: SITE.author, url: base.href },
  publisher: { "@type": "Person", name: SITE.author, url: base.href },
  isPartOf: { "@type": "Blog", name: SITE.title, url: base.href },
  ...(tags?.length ? { keywords: tags.join(", ") } : {}),
}).replace(/</g, "\\u003c")
---

<SeoMeta
  title={title}
  fullTitle={pageTitle(title)}
  description={description}
  canonical={canonical}
  url={url}
  type="article"
  image={ogImage}
/>

<script type="application/ld+json" set:html={jsonLd} />
<meta property="article:published_time" content={isoDate}>
<meta property="article:author" content={SITE.author}>
<meta name="citation_title" content={title}>
<meta name="citation_author" content={SITE.author}>
<meta name="citation_date" content={highwireDate}>
<meta name="citation_publication_date" content={highwireDate}>
<meta name="citation_publisher" content={SITE.title}>
<meta name="citation_abstract" content={description}>
<meta name="citation_public_url" content={canonical}>
<meta name="citation_language" content={SITE.locale}>
{tags?.length ? <meta name="citation_keywords" content={tags.join("; ")} /> : null}
{tags?.map((tag) => <meta property="article:tag" content={tag} />)}
