---
import SeoMeta from "@/components/SeoMeta.astro"
import { SITE } from "@/consts"
import type { PostEntry } from "@/lib/data-utils"
import { pageTitle, plainTitle, siteOrigin } from "@/lib/site-utils"

type Props = {
  post: PostEntry
  canonical?: string
}

const { post, canonical: canonicalPath } = Astro.props
const { description = SITE.description, date, image, tags } = post.data
const title = plainTitle(post.data.title)

const base = siteOrigin(Astro)
const url = new URL(Astro.url.pathname, base)
const canonical = new URL(canonicalPath ?? Astro.url.pathname, base)
const ogImage = image ? new URL(image.src, base) : undefined

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ScholarlyArticle",
  headline: title,
  description,
  author: { "@type": "Person", name: SITE.author },
  datePublished: date.toISOString(),
  ...(tags?.length ? { keywords: tags.join(", ") } : {}),
  inLanguage: SITE.locale,
  mainEntityOfPage: canonical.href,
  url: canonical.href,
}).replace(/</g, "\\u003c")
---

<SeoMeta
  title={title}
  fullTitle={pageTitle(title)}
  description={description}
  canonical={canonical}
  url={url}
  type="article"
  image={ogImage}
/>

<script type="application/ld+json" set:html={jsonLd} />
<meta property="article:published_time" content={date.toISOString()}>
<meta property="article:author" content={SITE.author}>
<meta name="citation_title" content={title}>
<meta name="citation_author" content={SITE.author}>
<meta name="citation_publication_date" content={date.toISOString().slice(0, 10).replaceAll("-", "/")}>
<meta name="citation_public_url" content={canonical}>
{tags?.map((tag) => <meta property="article:tag" content={tag} />)}
