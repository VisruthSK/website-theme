---
import { biblatexEntry } from "@/lib/cite-post"
import type { PostEntry } from "@/lib/data-utils"
import { plainTitle, siteOrigin } from "@/lib/site-utils"

type Props = {
  post: PostEntry
  /** Override the canonical, e.g. for subposts: the pages they belong to. */
  canonical?: string
}

const { post, canonical: canonicalPath } = Astro.props
const base = siteOrigin(Astro)
const url = new URL(canonicalPath ?? Astro.url.pathname, base).href
const entry = biblatexEntry({
  id: post.id,
  title: plainTitle(post.data.title),
  date: post.data.date,
  url,
})
---

<details class="cite-post" data-pagefind-ignore>
  <summary>Cite this post</summary>
  <pre><code>{entry}</code></pre>
</details>

<style>
  .cite-post {
    margin-block-start: var(--space-m);
    padding: var(--space-xs) var(--space-s);
    border: var(--box-border);
    border-radius: var(--radius-xl);
    font-size: var(--step--1);
    color: var(--muted-foreground);
  }

  summary {
    cursor: pointer;
    inline-size: fit-content;
  }

  summary:hover {
    color: var(--foreground);
  }

  pre {
    overflow-x: auto;
    margin-block-start: var(--space-xs);
    font-size: var(--step--2);
  }
</style>
