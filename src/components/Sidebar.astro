---
import CrumbItems from "@/components/CrumbItems.astro"
import ThemeToggle from "@/components/ThemeToggle.astro"
import { NAVIGATION, SITE } from "@/consts"
import MenuIcon from "@/icons/menu.svg"
import CloseIcon from "@/icons/x.svg"
import { withBase } from "@/lib/base"
import { externalTo, newTabProps } from "@/lib/external-link-utils"
import { normalizePath } from "@/lib/utils"

type Props = { crumbs?: { label: string; href: string }[] }

const { crumbs = [] } = Astro.props
const pathname = normalizePath(Astro.url.pathname) || "/"
const section = NAVIGATION.find(
  ({ href }) => pathname === href || pathname.startsWith(`${href}/`),
)
const isExternal = externalTo(SITE.href)
---

<header data-bar>
  <input
    type="checkbox"
    id="menu-toggle"
    class="menu-toggle sr-only"
    aria-controls="site-nav"
  />
  <a href={withBase("/")} data-brand>
    <span>{SITE.title}</span>
    {import.meta.env.DEV && <dev-badge>dev</dev-badge>}
  </a>
  <sidebar-controls>
    <ThemeToggle />
    <label for="menu-toggle" data-icon-button data-menu-button>
      <MenuIcon aria-hidden="true" />
      <CloseIcon aria-hidden="true" />
      <span class="sr-only">Menu</span>
    </label>
  </sidebar-controls>
  <nav id="site-nav" aria-label="Primary">
    <ul>
      {NAVIGATION.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={pathname === item.href ? "page" : undefined}
            {...newTabProps(isExternal(item.href))}
          >
            {item.label}
          </a>
          {item === section && crumbs.length > 0 && pathname !== item.href && (
            <ul>
              <CrumbItems crumbs={crumbs} />
            </ul>
          )}
        </li>
      ))}
      {!section && <CrumbItems crumbs={crumbs} />}
    </ul>
  </nav>
</header>

<style>
  [data-bar] {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2xs) var(--space-s);
    font-family: var(--font-sans);
    padding-block: var(--space-2xs);
    padding-inline: var(--grid-gutter);

    @media (width >= 64rem) {
      padding: 0;
      display: contents;
    }
  }

  [data-brand] {
    order: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    inline-size: fit-content;
    font-family: var(--font-serif);
    font-size: 16pt;
    font-weight: var(--font-weight-medium);
    color: var(--flourish);
    text-decoration-line: none;

    @media (width >= 64rem) {
      margin-block-end: var(--space-2xs);
      font-size: 20pt;
    }
  }

  dev-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-full);
    background: var(--danger);
    color: var(--danger-foreground);
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  sidebar-controls {
    order: 1;
    display: flex;
    align-items: center;
    gap: var(--space-3xs);
    margin-inline-start: auto;
    margin-inline-end: -0.5rem;

    @media (width >= 64rem) {
      order: 3;
      margin: auto 0 0 -0.5rem;
    }
  }

  [data-menu-button] {
    svg:nth-of-type(2) {
      display: none;
    }

    @media (width >= 64rem) {
      display: none;
    }
  }

  .menu-toggle {
    @media (width >= 64rem) {
      display: none;
    }
  }

  [data-bar]:has(.menu-toggle:checked) [data-menu-button] {
    svg:nth-of-type(1) {
      display: none;
    }

    svg:nth-of-type(2) {
      display: block;
    }
  }

  [data-bar]:has(.menu-toggle:focus-visible) [data-menu-button] {
    outline: var(--focus-ring);
    outline-offset: var(--focus-ring-offset);
  }

  nav {
    order: 2;
    flex-basis: 100%;
    display: none;

    @media (width >= 64rem) {
      order: 1;
      flex-basis: auto;
      display: block;
    }
  }

  [data-bar]:has(.menu-toggle:checked) nav {
    display: block;
  }

  nav ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  nav ul ul {
    margin-block-start: var(--space-3xs);
  }

  nav ul :global(a) {
    display: block;
    font-size: 1.0625rem;
    color: var(--ink-muted);
    text-decoration-line: none;
    transition: color var(--duration-fast) ease;
  }

  nav ul :global(a:hover) {
    color: var(--ink-soft);
  }

  nav ul :global(a[aria-current="page"]) {
    color: var(--foreground);
    font-weight: 500;
  }

  nav ul :global(li[data-depth="1"] a),
  nav ul ul :global(a) {
    font-size: calc(1.0625rem - 2pt);
  }

  nav ul :global(li[data-depth="1"] a) {
    margin-inline-start: var(--space-xs);
  }

  nav ul ul :global(a) {
    margin-inline-start: var(--space-xs);
  }

  nav ul ul :global(li[data-depth="1"] a) {
    margin-inline-start: calc(2 * var(--space-xs));
  }
</style>
