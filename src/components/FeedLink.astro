---
import { withBase } from "@/lib/base"
import { siteOrigin } from "@/lib/site-utils"

type Props = { href: string; title: string; type?: string }

const { href, title, type = "application/rss+xml" } = Astro.props
---

<link
  rel="alternate"
  type={type}
  title={title}
  href={new URL(withBase(href), siteOrigin(Astro)).href}
/>
