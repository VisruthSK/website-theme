---
import { FEATURES } from "@/consts"

interface Props {
  description?: string
  entries?: boolean
  parentTitle?: string
  parentUrl?: string
  publishedAt?: string
  sectionLabel: string
  tags?: string[]
  wordCount?: number
}

const {
  description,
  entries = false,
  parentTitle,
  parentUrl,
  publishedAt,
  sectionLabel,
  tags = [],
  wordCount,
} = Astro.props

const fields = (
  [
    ["section_label", sectionLabel],
    ["entries", entries && "true"],
    ["description", description],
    ["published_at", publishedAt],
    ["word_count", typeof wordCount === "number" && String(wordCount)],
    ["tags", JSON.stringify(tags.filter(Boolean))],
    ["parent_title", parentTitle],
    ["parent_url", parentUrl],
  ] as [string, string | false | undefined][]
).filter((field): field is [string, string] => Boolean(field[1]))
---

{
  FEATURES.search &&
    fields.map(([name, content]) => (
      <meta
        name={`pagefind:${name}`}
        data-pagefind-meta={`${name}[content]`}
        data-pagefind-sort={name === "published_at" ? `${name}[content]` : undefined}
        content={content}
      />
    ))
}
