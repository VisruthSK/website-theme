---
import Card from "@/components/Card.astro"
import MetaRow from "@/components/MetaRow.astro"
import TagChip from "@/components/TagChip.astro"
import type { CardData } from "@/lib/card"
import { formatTitleAsHtml } from "@/lib/text"

type Props = CardData & { heading?: "h2" | "h3" }

const {
  href,
  title,
  eyebrow,
  excerpt,
  date,
  stats,
  series,
  tags = [],
  heading: Heading = "h3",
} = Astro.props
---

<Card href={href} label={title}>
  {eyebrow && <div class="card-eyebrow">{eyebrow}</div>}
  <Heading class="card-title" set:html={formatTitleAsHtml(title)} />
  {excerpt !== undefined && <p class="card-excerpt">{excerpt}</p>}
  <MetaRow date={date} items={stats} />
  {
    (series || tags.length > 0) && (
      <div class="chip-list">
        {series && (
          <a href={series.href} class="chip">
            {series.title}
          </a>
        )}
        {tags.map((tag) => (
          <TagChip tag={tag} />
        ))}
      </div>
    )
  }
</Card>
