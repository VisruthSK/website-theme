---
import FeedLink from "@/components/FeedLink.astro"
import FontPreload from "@/components/FontPreload.astro"
import { withBase } from "@/lib/base"
import theme from "@/scripts/theme.js?url&no-inline"
import { BROWSER_COLORS, SITE } from "@/consts"
import { fonts } from "virtual:theme/assets"
---

<head>
  <meta charset="utf-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, user-scalable=yes"
  />
  <meta name="color-scheme" content="light dark" />
  <meta name="generator" content={Astro.generator} />

  <meta name="HandheldFriendly" content="True" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content={SITE.title} />
  <meta
    name="format-detection"
    content="telephone=no,date=no,address=no,email=no,url=no"
  />

  <meta
    name="theme-color"
    content={BROWSER_COLORS.dark}
    media="(prefers-color-scheme: dark)"
  />
  <meta
    name="theme-color"
    content={BROWSER_COLORS.light}
    media="(prefers-color-scheme: light)"
  />

  <link rel="icon" href="data:;base64,=" />
  <link rel="manifest" href={withBase("/site.webmanifest")} />

  <link rel="sitemap" href={withBase("/sitemap-index.xml")} />
  <FeedLink href="/rss.xml" title={SITE.title} />

  <FontPreload href={fonts.heading} />
  <FontPreload href={fonts.body} />
  <script is:inline src={theme}></script>
  <slot />
</head>
