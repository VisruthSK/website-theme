---
import EntryGroup from "@/components/EntryGroup.astro"
import PostCard from "@/components/PostCard.astro"
import type { PostEntry } from "@/lib/data-utils"
import { groupByYear } from "@/lib/group"

type Props = { entries: PostEntry[] }

const groups = groupByYear(Astro.props.entries, (entry) => entry.data.date)
---

{
  groups.map(({ heading, entries }) => (
    <EntryGroup heading={heading} year>
      {entries.map((entry) => (
        <PostCard entry={entry} />
      ))}
    </EntryGroup>
  ))
}
