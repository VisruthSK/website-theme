---
import type { HTMLAttributes } from "astro/types"

import Time from "@/components/Time.astro"

type Item = { text: string; class?: string } | string

type Props = HTMLAttributes<"div"> & {
  date?: Date
  items?: (Item | false | null | undefined)[]
}

const { date, items = [], class: className, ...attributes } = Astro.props
const parts = items.filter((item): item is Item => Boolean(item))
---

{
  (date || parts.length > 0) && (
    <div class:list={["meta-row", className]} {...attributes}>
      {date && (
        <span>
          <Time date={date} class="dt-published" />
        </span>
      )}
      {parts.map((part, index) => (
        <>
          {(date || index > 0) && <span class="meta-divider" aria-hidden="true" />}
          {typeof part === "string" ? (
            <span>{part}</span>
          ) : (
            <span class={part.class}>{part.text}</span>
          )}
        </>
      ))}
    </div>
  )
}
