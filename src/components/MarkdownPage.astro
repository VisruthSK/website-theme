---
import Page from "@/components/Page.astro"
import PagefindMeta from "@/components/PagefindMeta.astro"
import { assertNoBrokenLinks } from "@/lib/links"
import { formatTitleAsHtml } from "@/lib/text"
import type { CollectionEntry } from "astro:content"
import { render } from "astro:content"

interface Props {
  entry: CollectionEntry<"pages">
}

const { entry } = Astro.props
const { Content, remarkPluginFrontmatter } = await render(entry)
assertNoBrokenLinks(entry.id, remarkPluginFrontmatter)
const { title, description, date } = entry.data
---

<Page
  title={title}
  headingHtml={formatTitleAsHtml(title)}
  description={description}
  crumb={`/${entry.id}`}
  body="article"
>
  <PagefindMeta
    slot="head"
    description={description}
    publishedAt={date instanceof Date ? date.toISOString() : undefined}
    sectionLabel="Pages"
  />
  <prose-content>
    <Content />
  </prose-content>
</Page>
