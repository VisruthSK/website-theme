---
import "@/styles/reset.css"
import "@/styles/color.css"
import "@/styles/typography.css"
import "@/styles/typography-headings.css"
import "@/styles/typography-inline.css"
import "@/styles/typography-lists.css"
import "@/styles/typography-block.css"
import "@/styles/typography-tables.css"
import "@/styles/typography-math.css"
import "@/styles/callout.css"
import "@/styles/layout.css"
import "@/styles/icon-button.css"
import "@/styles/shape.css"
import "@/generated/theme.css"
import "@/styles/base.css"
import "@/styles/prose.css"
import "@/styles/components.css"
import "@/styles/print.css"
import "@/styles/notes.css"

import ExternalLinkSprite from "@/components/ExternalLinkSprite.astro"
import Footer from "@/components/Footer.astro"
import MetaHead from "@/components/MetaHead.astro"
import Sidebar from "@/components/Sidebar.astro"
import { SITE } from "@/consts"

type Props = { crumbs?: { label: string; href: string }[] }

const { crumbs } = Astro.props
---

<html lang={SITE.locale} dir={SITE.dir}>
  <MetaHead>
    <slot name="head" />
  </MetaHead>
  <body>
    <ExternalLinkSprite />
    <page-grid>
      <page-header>
        <Sidebar crumbs={crumbs} />
        {Astro.slots.has("toc") && (
          <page-toc>
            <slot name="toc" />
          </page-toc>
        )}
      </page-header>
      <page-content>
        <main>
          <slot />
        </main>
        <page-footer>
          <Footer />
        </page-footer>
      </page-content>
    </page-grid>
  </body>
</html>

<style is:global>
  html {
    @media (width < 64rem) {
      scroll-padding-block-start: var(--space-xs);
    }
  }

  page-grid {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
    gap: var(--grid-gutter);
    max-width: var(--grid-max-width);
    min-height: 100svh;
    margin-inline: auto;
    padding-inline: var(--grid-gutter);
    padding-block-start: var(--page-offset-top);

    @media (width < 64rem) {
      grid-template-columns: 1fr;
      grid-template-rows: auto 1fr;
      padding-block-start: 0;
    }
  }

  page-header {
    display: block;
    min-width: 0;
    grid-column: 1 / 3;
    grid-row: 1;

    @media (width >= 64rem) {
      position: fixed;
      inset-block: var(--page-offset-top) var(--page-offset-bottom);
      inset-inline-start: var(--grid-edge);
      display: flex;
      flex-direction: column;
      inline-size: calc(2 * var(--grid-column-width) + var(--grid-gutter));
    }

    @media (width < 64rem) {
      grid-column: 1 / -1;
      margin-inline: calc(-1 * var(--grid-gutter));
    }
  }

  page-toc {
    display: block;
    min-width: 0;
    font-family: var(--font-sans);

    nav > ul {
      font-size: calc(var(--step--1) - 1pt);
    }

    @media (width < 64rem) {
      padding-inline: var(--grid-gutter);
      padding-block-end: var(--space-2xs);

      nav > ul {
        z-index: 5;
        padding: var(--space-xs);
        border-radius: var(--radius-md);
        background: var(--background);
        box-shadow: var(--shadow-popover);
      }
    }

    @media (width >= 64rem) {
      order: 2;
      flex: 1 1 0;
      min-block-size: 0;
      margin-block: var(--space-m) var(--space-xs);
      overflow-y: auto;

      nav {
        position: static;
        max-block-size: none;
      }
    }
  }

  page-content {
    display: flex;
    flex-direction: column;
    grid-column: 3 / 10;
    grid-row: 1;
    min-width: 0;
    margin-block-start: -0.1em;

    main {
      flex: 1;
    }

    page-footer {
      display: block;
      margin-block-start: var(--space-xl);
    }

    @media (width < 64rem) {
      grid-column: 1 / -1;
      grid-row: auto;
      inline-size: 100%;
      max-inline-size: var(--measure);
      margin-inline: auto;
      padding-block-start: var(--space-s);
    }
  }
</style>
