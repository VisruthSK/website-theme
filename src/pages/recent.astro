---
import Page from "@/components/Page.astro"
import YearGroups from "@/components/YearGroups.astro"
import { PAGES } from "@/consts"
import { getSectionPostsChrono } from "@/lib/section-posts"

const posts = await getSectionPostsChrono()
---

<Page title="Recent" description={PAGES.recent.description} crumb="/recent">
  <YearGroups entries={posts} />
</Page>
