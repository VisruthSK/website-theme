---
import MetaPage from '@/components/MetaPage.astro'
import PageHeading from '@/components/PageHeading.astro'
import YearGroups from '@/components/YearGroups.astro'
import { PAGES } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getSectionPostsChrono } from '@/lib/section-posts'

const posts = await getSectionPostsChrono()
---

<Layout crumbs={[{ label: 'Recent', href: '/recent' }]}>
  <MetaPage
    slot="head"
    title="Recent"
    description={PAGES.recent.description}
  />
  <PageHeading title="Recent" />
  <YearGroups entries={posts} />
</Layout>
