---
import MetaPage from '@/components/MetaPage.astro'
import PageHeading from '@/components/PageHeading.astro'
import TagChip from '@/components/TagChip.astro'
import { SECTIONS, SECTION_SLUGS } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getSortedTags } from '@/lib/data-utils'

const sortedTags = await getSortedTags(
  SECTION_SLUGS.map((slug) => SECTIONS[slug].collection),
)
---

<Layout crumbs={[{ label: 'Tags', href: '/tags' }]}>
  <MetaPage slot="head" title="Tags" />
  <PageHeading title="Tags" />
  <div class="chip-list">
    {
      sortedTags.map(({ tag, count }) => (
        <TagChip tag={tag} count={count} />
      ))
    }
  </div>
</Layout>
