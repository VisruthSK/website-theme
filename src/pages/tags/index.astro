---
import Page from '@/components/Page.astro'
import TagChip from '@/components/TagChip.astro'
import { SECTIONS, SECTION_SLUGS } from '@/consts'
import { getSortedTags } from '@/lib/data-utils'

const sortedTags = await getSortedTags(
  SECTION_SLUGS.map((slug) => SECTIONS[slug].collection),
)
---

<Page title="Tags" crumb="/tags">
  <div class="chip-list">
    {sortedTags.map(({ tag, count }) => <TagChip tag={tag} count={count} />)}
  </div>
</Page>
