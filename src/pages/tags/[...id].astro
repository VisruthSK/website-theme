---
import { withBase } from '@/lib/base'
import EntryCard from '@/components/EntryCard.astro'
import MetaPage from '@/components/MetaPage.astro'
import { SECTIONS, SECTION_SLUGS, SITE } from '@/consts'
import RSS from '@/icons/rss.svg'
import Layout from '@/layouts/Layout.astro'
import { getAllTags, getPostsByTag } from '@/lib/data-utils'

export async function getStaticPaths() {
  const collections = SECTION_SLUGS.map((slug) => SECTIONS[slug].collection)
  const tags = await getAllTags(collections)

  return Promise.all(
    [...tags.keys()].map(async (tag) => {
      const posts = (
        await Promise.all(
          collections.map((collection) => getPostsByTag(tag, collection)),
        )
      )
        .flat()
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
      return { params: { id: tag }, props: { tag, posts } }
    }),
  )
}

const { tag, posts } = Astro.props
const feedHref = withBase(`/tags/${encodeURIComponent(tag)}/rss.xml`)
---

<Layout
  crumbs={[{ label: `#${tag}`, href: `/tags/${encodeURIComponent(tag)}` }]}
>
  <MetaPage
    slot="head"
    title={`Posts tagged with "${tag}"`}
    description={`A collection of posts tagged with ${tag}.`}
    noindex
  />
  <link
    slot="head"
    rel="alternate"
    type="application/rss+xml"
    title={`RSS feed for #${tag}`}
    href={new URL(feedHref, SITE.href).href}
  />

  <page-heading>
    <h1>#{tag}</h1>
    <a href={feedHref} data-icon-button aria-label={`RSS feed for ${tag}`}>
      <RSS />
    </a>
  </page-heading>
  <p class="meta-row">
    {posts.length} post{posts.length === 1 ? '' : 's'}
  </p>
  <ul data-entries>
    {posts.map((post) => (
      <EntryCard heading="h2" entry={post} />
    ))}
  </ul>
</Layout>
